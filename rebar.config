{erl_opts, [debug_info, {parse_transform, lager_transform}]}.

{deps, [
    {nksip,  {git, "https://github.com/netcomposer/nksip", {tag, "v0.6.1"}}},
    {jsx,    "3.1.0"},
    {lager,  "3.9.2"},
    {meck,   "0.8.12"},
    {cowboy, "1.1.2"}
]}.

{overrides, [
    {override, ranch,  [{vsn, "1.6.2"}]},
    {override, cowboy, [{vsn, "1.1.2"}]}
]}.

{shell, [
    {config, "priv/sys.config"},
    {apps, [sipcall]}
]}.
